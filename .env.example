# ---------------------------------------------------------------------------
# NEXUS OS — environment variables
#
# Copy to `.env.local` and fill in. Never commit real secrets.
# This file is validated against the Zod schema in src/kernel/config/env.ts by
# `npm run check:env` (also run in CI), so the two can never drift.
#
# Variables for auth, AI, storage, email and payments are introduced by the
# phase that first reads them (docs/OPERATIONS.md §P.4 lists the full target set).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development

# --- Public (inlined into the client bundle — never put a secret here) -------
NEXT_PUBLIC_APP_NAME=NEXUS OS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Pooled connection used at runtime (PgBouncer / Neon pooler).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_os

# Direct, unpooled connection — used by `prisma migrate` only.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_os
