# ---------------------------------------------------------------------------
# NEXUS OS — environment variables
#
# Copy to `.env.local` and fill in. Never commit real secrets.
# This file is validated against the Zod schema in src/kernel/config/env.ts by
# `npm run check:env` (also run in CI), so the two can never drift.
#
# Variables for auth, AI, storage, email and payments are introduced by the
# phase that first reads them (docs/OPERATIONS.md §P.4 lists the full target set).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development

# --- Public (inlined into the client bundle — never put a secret here) -------
NEXT_PUBLIC_APP_NAME=NEXUS OS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Pooled connection used at runtime (PgBouncer / Neon pooler).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_os

# Direct, unpooled connection — used by `prisma migrate` only.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_os

# --- Document storage (Phase 12) --------------------------------------------
# `local` writes to a gitignored directory and is for development only: a
# serverless host has an ephemeral filesystem, so production must use `s3`.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage

# Optional cap, in bytes. Defaults to 25 MB when unset.
# STORAGE_MAX_UPLOAD_BYTES=26214400

# Required only when STORAGE_DRIVER=s3. Works with AWS S3, Cloudflare R2, MinIO
# and other S3-compatible stores. The bucket MUST be private: nothing in this
# application ever issues a public object URL.
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# S3_REGION=eu-west-1
# S3_BUCKET=nexus-os-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Scheduled tasks (Phase 13) ---------------------------------------------
# Shared secret for /api/cron/*. Generate with: openssl rand -base64 32
# Without it, scheduled endpoints refuse every request — which is the safe
# default, not a bug.
# CRON_SECRET=

# --- AI (Phase 15) ----------------------------------------------------------
# Without a key the assistant is unavailable and says so. Insights, usage
# reporting and conversation history keep working: they are computed from your
# own data, not generated.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Hard monthly ceiling in micros of USD (50000000 = 50 USD). Calls are refused
# once the organization passes it.
AI_MONTHLY_BUDGET_MICROS=50000000
